# Optional polite contact address for OpenAlex (recommended by their API)
OPENALEX_MAILTO=you@example.com

# Optional local model provider. Leave LLM_PROVIDER=none for search-only use.
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
# Set this to an installed tag returned by `ollama list`; never assume a tag.
OLLAMA_MODEL=
